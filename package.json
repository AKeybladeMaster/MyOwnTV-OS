{
  "name": "myowntv-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A standalone, offline home app for LG webOS 5 televisions",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "package": "node tools/package.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-flow.mjs",
    "preview": "node tools/preview.mjs",
    "tv": "node tools/tv.mjs",
    "verify": "npm test && npm run package"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "ssh2": "1.17.0",
    "ws": "8.22.0"
  }
}
